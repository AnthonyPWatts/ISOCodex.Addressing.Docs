<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- ISOCodex dependencies and published-package examples use the public feed. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Explicit audit source makes a missing vulnerability database an error. -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://data.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
