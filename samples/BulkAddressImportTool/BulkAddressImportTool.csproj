<Project Sdk="Microsoft.NET.Sdk">


  <ItemGroup>
    <PackageReference Include="ISOCodex.Countries" Version="1.1.1" />
  </ItemGroup>

<ItemGroup>
    <PackageReference Include="ISOCodex.Addressing" Version="2.1.1" />
    <PackageReference Include="ISOCodex.Addressing.GreatBritain" Version="2.1.1" />
    <PackageReference Include="ISOCodex.Addressing.Spain" Version="2.1.1" />
    <PackageReference Include="ISOCodex.Addressing.France" Version="2.1.1" />
    <PackageReference Include="ISOCodex.Addressing.Ireland" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SampleData\addresses.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
