@page
@using ISOCodex.Addressing.Profiles
@model IndexModel
@{
    ViewData["Title"] = "Dynamic address form";
    ViewData["Description"] = "A portfolio-ready demonstration of profile-driven address fields, country validation and postal formatting for Spain, France and Ireland.";
    var activeFields = Model.Profile.Fields.Count(field => field.IsUsed && field.Field != AddressField.Country);
    var requiredFields = Model.Profile.Fields.Count(field => field.IsUsed && field.IsRequired && field.Field != AddressField.Country);
    var statusClass = Model.Status switch
    {
        "Valid" => "status-panel--valid",
        "Invalid" => "status-panel--invalid",
        _ => "status-panel--idle"
    };
}

<div id="portfolio-capture"
     data-portfolio-capture="address-form-demo"
     data-portfolio-project="ISOCodex.Addressing"
     data-portfolio-state="@Model.Status.ToLowerInvariant()">
<section class="demo-hero">
    <div>
        <p class="eyebrow">Profile-driven address entry</p>
        <h1>One form.<br />The right local shape.</h1>
    </div>
    <p class="demo-hero__summary">
        Switch country or scenario to see field order, terminology, options,
        validation and formatting adapt through the public addressing APIs.
    </p>
</section>

<section class="scenario-panel" aria-labelledby="scenario-heading" data-portfolio-region="scenario-controls">
    <div class="scenario-panel__intro">
        <span class="step-number" aria-hidden="true">01</span>
        <div>
            <h2 id="scenario-heading">Choose a scenario</h2>
            <p>Samples run immediately. Edit any field and validate again.</p>
        </div>
    </div>
    <form method="get" class="scenario-controls">
        <div class="field-group">
            <label class="form-label" for="country">Country profile</label>
            <div class="select-shell">
                <select id="country" name="CountryCode" class="form-select" onchange="this.form.submit()">
                    @foreach (var country in Model.Countries)
                    {
                        <option value="@country.Code" selected="@(country.Code == Model.CountryCode)">@country.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="field-group field-group--wide">
            <label class="form-label" for="sample">Validation scenario</label>
            <div class="select-shell">
                <select id="sample" name="SampleId" class="form-select" onchange="this.form.submit()">
                    <option value="">Start with a blank form</option>
                    @foreach (var sample in Model.Samples.Where(sample => sample.CountryCode == Model.CountryCode))
                    {
                        <option value="@sample.Id" selected="@(sample.Id == Model.SampleId)">@sample.Name</option>
                    }
                </select>
            </div>
        </div>
    </form>
</section>

<div class="demo-grid">
    <section class="form-panel" aria-labelledby="address-heading" data-portfolio-region="country-aware-form">
        <div class="panel-heading">
            <span class="step-number" aria-hidden="true">02</span>
            <div>
                <p class="panel-kicker">@Model.CountryCode · @Model.CountryName</p>
                <h2 id="address-heading">Local address fields</h2>
            </div>
            <div class="profile-stats" aria-label="Profile field summary">
                <span><strong>@activeFields</strong> fields</span>
                <span><strong>@requiredFields</strong> required</span>
            </div>
        </div>

        <form method="post" class="address-form">
            <input type="hidden" asp-for="Input.CountryCode" value="@Model.CountryCode" />
            <input type="hidden" asp-for="SampleId" />
            @foreach (var field in Model.Profile.Fields.Where(field => field.IsUsed).OrderBy(field => field.DisplayOrder))
            {
                var inputName = field.Field switch
                {
                    AddressField.AddressLine1 => nameof(Model.Input.Line1),
                    AddressField.AddressLine2 => nameof(Model.Input.Line2),
                    AddressField.Locality => nameof(Model.Input.City),
                    AddressField.AdministrativeArea => nameof(Model.Input.StateOrProvince),
                    AddressField.PostalCode => nameof(Model.Input.PostalCode),
                    AddressField.Country => nameof(Model.Input.CountryCode),
                    _ => field.Field.ToString()
                };
                var fullName = $"Input.{inputName}";
                var value = inputName switch
                {
                    nameof(Model.Input.Line1) => Model.Input.Line1,
                    nameof(Model.Input.Line2) => Model.Input.Line2,
                    nameof(Model.Input.City) => Model.Input.City,
                    nameof(Model.Input.StateOrProvince) => Model.Input.StateOrProvince,
                    nameof(Model.Input.PostalCode) => Model.Input.PostalCode,
                    nameof(Model.Input.CountryCode) => Model.Input.CountryCode,
                    _ => ""
                };
                var issueText = Model.IssueTextFor(inputName);

                if (field.Field == AddressField.Country)
                {
                    <input type="hidden" name="@fullName" value="@Model.CountryCode" />
                    continue;
                }

                <div class="address-field">
                    <label class="form-label" for="@inputName">
                        @field.Label
                        @if (field.IsRequired)
                        {
                            <span class="required-mark">Required</span>
                        }
                    </label>
                    @if (field.InputKind == AddressFieldInputKind.Select)
                    {
                        <select id="@inputName" name="@fullName" class="form-select @(string.IsNullOrWhiteSpace(issueText) ? "" : "is-invalid")">
                            <option value="">Select...</option>
                            @foreach (var option in field.Options)
                            {
                                <option value="@option.Value" selected="@(option.Value == value)">@option.Label</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input id="@inputName" name="@fullName" value="@value" placeholder="@field.Placeholder" class="form-control @(string.IsNullOrWhiteSpace(issueText) ? "" : "is-invalid")" />
                    }
                    @if (!string.IsNullOrWhiteSpace(field.HelpText))
                    {
                        <div class="form-text">@field.HelpText</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(issueText))
                    {
                        <div class="invalid-feedback d-block">@issueText</div>
                    }
                </div>
            }

            <button class="validate-button" type="submit">
                Validate this address
                <span aria-hidden="true">→</span>
            </button>
        </form>
    </section>

    <aside class="results-column" aria-label="Address validation result">
        <section class="status-panel @statusClass" data-portfolio-region="validation-result">
            <div class="status-panel__heading">
                <div>
                    <p class="panel-kicker">Validation result</p>
                    <h2>@Model.Status</h2>
                </div>
                <span class="status-icon" aria-hidden="true">
                    @(Model.Status == "Valid" ? "✓" : Model.Status == "Invalid" ? "!" : "–")
                </span>
            </div>

            @if (Model.FieldIssues.Count > 0)
            {
                <ul class="issue-list">
                    @foreach (var issue in Model.FieldIssues)
                    {
                        <li>
                            <strong>@Model.FieldLabelFor(issue.Field)</strong>
                            <span>@issue.Message</span>
                        </li>
                    }
                </ul>
            }
            else if (Model.FormattedPreview is null)
            {
                <p class="status-panel__empty">Choose a sample or enter an address to exercise the country validator.</p>
            }
            else
            {
                <div class="formatted-address">
                    <p class="formatted-address__label">Formatted for delivery</p>
                    <address>@Model.FormattedPreview</address>
                </div>
            }
        </section>

        <section class="profile-panel" data-portfolio-region="profile-evidence">
            <div class="profile-panel__heading">
                <div>
                    <p class="panel-kicker">Active profile</p>
                    <h2>@Model.CountryName</h2>
                </div>
                <span class="country-code">@Model.CountryCode</span>
            </div>
            <dl class="profile-facts">
                <div>
                    <dt>Form fields</dt>
                    <dd>@activeFields</dd>
                </div>
                <div>
                    <dt>Required</dt>
                    <dd>@requiredFields</dd>
                </div>
                <div>
                    <dt>Admin area</dt>
                    <dd>@(Model.Profile.Fields.FirstOrDefault(field => field.Field == AddressField.AdministrativeArea)?.InputKind.ToString() ?? "None")</dd>
                </div>
            </dl>
            <details class="metadata-details">
                <summary>Inspect raw profile metadata</summary>
                <pre class="profile-json">@Model.RawProfileJson</pre>
            </details>
        </section>
    </aside>
</div>
</div>
